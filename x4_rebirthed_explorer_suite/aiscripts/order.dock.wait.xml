<?xml version="1.0" encoding="utf-8"?>

<diff xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://x4dynlib.access.ly\libraries\aiscripts.xsd">

   <!-- from X4RE_ScriptLibrary -->
   <add sel="//params">
      <param name="IDLE_RETURN_HOME"  type="internal" default="false"/>
   </add>
   <add sel="//create_order[@name='$dockorder'][@object='this.assignedcontrolled']">
      <param name="IDLE_RETURN_HOME" value="$IDLE_RETURN_HOME"/>
   </add>
   <add sel="//interrupts">
      <handler>
         <conditions>
            <event_object_signalled object="this.ship" param="'Cancel_IdleReturnHome'"/>
            <check_value value="$IDLE_RETURN_HOME == true"/>
         </conditions>
         <actions>
            <cancel_order order="this.ship.order"/>
         </actions>
      </handler>
   </add>

   <!-- from X4RE_AnotherExplorer -->
   <add sel="//init">
      <do_if value="@this.ship.defaultorder.id == 'x4re.AnotherExplorer.global' and this.ship.subordinates.count gt 0">
         <set_value name="$dockfollowers" exact="false"/>
      </do_if>
   </add>

   <!-- from X4RE_SpiralExplorer -->
   <add sel="//init">
      <do_if value="@this.ship.defaultorder.id == 'x4re.SpiralExplorer.global' and this.ship.subordinates.count gt 0">
         <set_value name="$dockfollowers" exact="false"/>
      </do_if>
   </add>

   <!-- from X4RE_TradeSubscriptionExplorer -->
   <add sel="//init">
      <do_if value="@this.ship.defaultorder.id == 'x4re.TradeSubscriptionExplorer.global' and this.ship.subordinates.count gt 0">
         <set_value name="$dockfollowers" exact="false"/>
      </do_if>
   </add>

</diff>
